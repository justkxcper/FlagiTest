<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#50729E"
    android:gravity="center"
    tools:context=".MainActivity">
    <!--
    obowiązkowo dla każdego elementu musi być wysokość i szerokość
    match_parent - rozmiar elementu taki jak rodzica
    wrap_content - rozmiar dostosowany do zawartości
    -->

    <TextView
        android:id="@+id/textViewPytanie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="@dimen/rozmiar_tekstu_pytanie"
        android:layout_margin="16dp"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:background="#66000000"
        android:text="@string/polecenie" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_button"
                android:layout_weight="1"
                android:backgroundTint="@color/orange"
                android:onClick="sprawdzNieOK"
                android:text="" />

            <Button
                android:id="@+id/button5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_button"
                android:layout_weight="1"
                android:backgroundTint="@color/red"
                android:onClick="sprawdzOK"
                android:text="" />

            <Button
                android:id="@+id/button6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_button"
                android:layout_weight="1"
                android:backgroundTint="@color/purple"
                android:onClick="sprawdzNieOK"
                android:text="" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_button"
                android:layout_weight="1"
                android:backgroundTint="@color/white1"
                android:onClick="sprawdzOK"
                android:text="" />

            <!-- android:onClick="sprawdzOK()" - wiocha -->


            <Button
                android:id="@+id/button2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_button"
                android:layout_weight="1"
                android:backgroundTint="@color/black"
                android:onClick="sprawdzNieOK"
                android:text="" />

            <Button
                android:id="@+id/button3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_button"
                android:layout_weight="1"
                android:backgroundTint="@color/yellow"
                android:onClick="sprawdzNieOK"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>